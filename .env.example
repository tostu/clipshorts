# Where clips, artifacts and the SQLite DB live
DATA_DIR=./data

# Optional bearer token (primary protection should be VPN/Tailscale). Empty = no auth.
AUTH_TOKEN=

# Caption languages (auto-detect is clamped to this set)
LANGUAGES=de,en

# faster-whisper model (small | base | medium ...) and compute type
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Output fps cap (protects the N100)
FPS_CAP=30

# Worker niceness (higher = lower priority)
NICE_LEVEL=10

LOG_LEVEL=INFO
