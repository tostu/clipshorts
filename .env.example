# Where clips, artifacts and the SQLite DB live
DATA_DIR=./data

# Optional bearer token (primary protection should be VPN/Tailscale). Empty = no auth.
AUTH_TOKEN=

# Caption languages (auto-detect is clamped to this set)
LANGUAGES=de,en

# faster-whisper model (small | base | medium ...) and compute type
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8

# Layout detection: YuNet model path (empty = vendored clipshorts/models/*.onnx),
# and optional classifier threshold overrides as JSON (see LayoutParams in clipshorts/layout.py)
# YUNET_MODEL=/path/to/face_detection_yunet_2023mar.onnx
# LAYOUT_OVERRIDES={"fullcam_min_area": 0.1}

# Output fps cap (protects the N100)
FPS_CAP=30

# Render: libx264 (default) or h264_qsv (needs /dev/dri mounted into the container)
# VIDEO_ENCODER=libx264
# X264_PRESET=veryfast
# X264_CRF=20
# Stacked layout: facecam share of the output height
# RENDER_SPLIT_RATIO=0.38
# Render timeout = factor x clip duration, at least the minimum (seconds)
# RENDER_TIMEOUT_FACTOR=8
# RENDER_TIMEOUT_MIN_S=120

# Post hashtags: creator, <creator>clips, game, then this fixed set (comma separated, no #)
# FIXED_HASHTAGS=twitchclips,twitch,gaming,fyp,deutsch,twitchde
# MAX_HASHTAGS=10

# Followed-channel auto-sync (channels are picked in the UI)
# SYNC_ENABLED=true
# SYNC_INTERVAL_MINUTES=30
# SYNC_MAX_PER_CHANNEL=5

# Worker niceness (higher = lower priority)
NICE_LEVEL=10

LOG_LEVEL=INFO
